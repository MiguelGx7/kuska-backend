# Copia este archivo como .env y llena tus valores. Nunca subas el .env.

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- MySQL en Aiven ---
DB_NAME=kumora
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Ruta al ca.pem descargado de Aiven (relativa a la raíz del proyecto o absoluta)
DB_SSL_CA=ca.pem

# --- Cloudinary ---
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Correo (Gmail: usar contraseña de aplicación) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Copia este archivo como .env y llena tus valores. Nunca subas el .env.
# En Railway estas mismas variables se cargan en la pestaña Variables del servicio
# (ver docs/despliegue_railway.md).

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# True en desarrollo. En producción (Railway): False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Solo producción (con DEBUG=False; en local se pueden dejar vacías) ---
# Orígenes HTTPS del dominio del backend, para el admin de Django. Ej.: https://kumora.up.railway.app
CSRF_TRUSTED_ORIGINS=
# True para mostrar Swagger (api/docs/) en producción mientras se hacen los frontends.
SWAGGER_PUBLICO=False
# HSTS en segundos (por defecto 3600 = 1 hora). Subir a 31536000 cuando el dominio sea estable.
SECURE_HSTS_SECONDS=3600

# --- MySQL en Aiven ---
DB_NAME=kumora
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Local: ruta al ca.pem descargado de Aiven (relativa a la raíz del proyecto o absoluta).
DB_SSL_CA=ca.pem
# Railway (recomendado): el ca.pem en base64, en UNA sola línea. Para generarlo en PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("ca.pem")) | Set-Clipboard
# Prioridad: DB_SSL_CA_BASE64 > DB_SSL_CA_CONTENIDO > DB_SSL_CA. En local se dejan vacías.
DB_SSL_CA_BASE64=
# Alternativa: el CONTENIDO del ca.pem (texto con BEGIN/END CERTIFICATE). El editor de
# variables de Railway puede dañar los textos de varias líneas: mejor usar el base64.
DB_SSL_CA_CONTENIDO=

# --- Cloudinary ---
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Correo (recuperar contraseña) ---
# Se usa el primero que tenga valor:
#   1. BREVO_API_KEY     -> Brevo por API HTTPS (producción en Railway, que bloquea SMTP).
#   2. EMAIL_HOST_USER   -> SMTP (ej. Gmail con contraseña de aplicación).
#   3. ninguno           -> consola: el correo se muestra en la terminal (o en los logs).
# API key v3 de Brevo (empieza por xkeysib-). En local se deja vacía.
BREVO_API_KEY=
# Remitente: con Brevo debe ser un remitente VERIFICADO en Brevo. Ej.: Kumora <tu-correo@gmail.com>
DEFAULT_FROM_EMAIL=
# SMTP (solo si no usas Brevo):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Segundos máximos esperando al servidor de correo (SMTP o la API de Brevo).
EMAIL_TIMEOUT=10
